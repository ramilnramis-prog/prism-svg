# зависимости (ставятся локально, в репозиторий не нужны)
node_modules/

# локальный npm-кэш, которым обходим ограничения песочницы
.npm-cache/

# временные файлы разработки
dev-out/

# PNG-дампы: их всегда можно пересобрать командой --png.
# Раскомментируй, если не хочешь тащить бинарники в репозиторий.
# art/**/*.png

# системный мусор
Thumbs.db
desktop.ini
.DS_Store

# логи и editor-файлы
*.log
.vscode/
.idea/
